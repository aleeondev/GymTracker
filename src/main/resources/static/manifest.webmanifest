{
    "name": "Gym Tracker",
    "short_name": "Gym Tracker",
    "description": "Registra tus entrenamientos y sigue tu progreso en el gimnasio.",
    "lang": "es",
    "start_url": "/dashboard",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#f8f8f8",
    "theme_color": "#c92f4b",
