        { "src": "/img/favicon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Entrenar", "url": "/entrenamiento", "icons": [{ "src": "/img/favicon-192.png", "sizes": "192x192" }] },
        { "name": "Historial", "url": "/historial", "icons": [{ "src": "/img/favicon-192.png", "sizes": "192x192" }] }
    ]
}
